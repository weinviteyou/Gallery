---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArtworkGrid from '../components/ArtworkGrid.astro';
import EmptyState from '../components/EmptyState.astro';
import { getVisibleArtworks } from '../lib/artworks';

const artworks = getVisibleArtworks();
---

<BaseLayout title="Gallery" description="Paintings and photography, complete archive.">
  <PageHeader eyebrow={`${artworks.length} works`} title="Gallery" />
  <section class="pb-28">
    <div class="shell">
      {artworks.length === 0 ? <EmptyState /> : <ArtworkGrid artworks={artworks} />}
    </div>
  </section>
</BaseLayout>
