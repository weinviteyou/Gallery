---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PillButton from '../components/PillButton.astro';
import { site } from '../../site.config';
---

<BaseLayout title="Contact" description={`Contact ${site.name}.`}>
  <PageHeader eyebrow="Enquiries" title="Contact" />

  <section class="pb-28">
    <div class="shell grid gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="text-subheading font-light m-0 max-w-[20ch]">
          For availability, commissions, or press.
        </p>
        <PillButton
          href={`mailto:${site.email}?subject=${encodeURIComponent(`Enquiry — ${site.name}`)}`}
          class="mt-12"
        >
          Write to the studio
        </PillButton>
      </div>

      <div class="md:col-span-4 md:col-start-9">
        <p class="label text-felt-gray m-0">Email</p>
        <a class="link-quiet label mt-3 inline-block" href={`mailto:${site.email}`}>{site.email}</a>

        <p class="label text-felt-gray mt-10 mb-0">Studio</p>
        <p class="label mt-3 mb-0">{site.location}</p>

        <p class="label text-felt-gray mt-10 mb-0">Elsewhere</p>
        <ul class="list-none m-0 mt-3 p-0 flex flex-col gap-1">
          {
            site.socials.map((s) => (
              <li>
                <a class="link-quiet label" href={s.href} target="_blank" rel="noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
