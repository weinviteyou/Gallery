---
interface Props {
  headline: string;
  /** Quiet label pinned at the bottom-left, in the 11px register. */
  caption?: string;
  full?: boolean;
}

const { headline, caption, full = false } = Astro.props;
---

<section
  class:list={[
    'iridescent relative flex flex-col justify-end overflow-hidden',
    full ? 'min-h-svh' : 'min-h-[52svh]',
  ]}
>
  <!-- Wash keeps the display type legible over the gradient without tinting it. -->
  <div class="absolute inset-0 bg-obsidian/25 pointer-events-none"></div>

  <!-- The display headline owns the viewport; nothing crowds it. -->
  <div class="shell relative pb-20 pt-40 text-paper">
    <h1 class="text-display font-normal m-0 tracking-[-0.03em]">{headline}</h1>
  </div>

  {
    caption && (
      <div class="shell relative pb-10 text-paper">
        <p class="label m-0 opacity-80">{caption}</p>
      </div>
    )
  }
</section>
